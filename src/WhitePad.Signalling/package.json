{
  "name": "whitepad-signalling",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "test:browser": "playwright test",
    "load": "node tools/load.mjs",
    "test:restart": "node tools/restart-test.mjs",
    "test:deploy": "node --test tools/deploy.test.mjs tools/hosted-smoke.test.mjs",
    "deploy:ci": "node tools/deploy.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:quota": "node --experimental-strip-types --test tools/creationQuota.test.mjs",
    "test:hosted": "node tools/hosted-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "wrangler": "^4.151.3"
  }
}
